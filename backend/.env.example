# ===================================================
# Akbar Cricket Club — Team Management Suite (2026-2027)
# Backend Environment Configuration Template
# ===================================================

NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173

# MongoDB Connection String (e.g. mongodb://127.0.0.1:27017/akbar_cricket or MongoDB Atlas)
# Development only: a failed connection uses the embedded file-backed database.
# Production requires the existing Atlas URI and never falls back to local files.
MONGODB_URI=mongodb://127.0.0.1:27017/akbar_cricket

# For Atlas, set both to false to prevent local fallback and startup data changes.
ALLOW_EMBEDDED_DB=true
SEED_ON_STARTUP=true

# Optional resolver override if your computer cannot resolve Atlas SRV records.
MONGODB_DNS_SERVERS=

# JWT Secret for Session Authentication (Minimum 32 characters)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# 32-Byte Hex Key for AES-256-GCM encryption of sensitive fields (NIC numbers)
# WARNING: Never alter this key once records are encrypted.
FIELD_ENCRYPTION_KEY=replace_with_a_secure_32_byte_hex_string_64_chars

# Development-only initial administrator (choose your own password, at least 12 characters).
# Production seeding is disabled and these variables are not used in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Uploads directory (absolute, or relative to backend/)
UPLOADS_DIR=./uploads

# Optional AI Assistant configuration (leaves empty to use built-in rule-based engine)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
