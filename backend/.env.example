# ===================================================
# Akbar Cricket Club — Team Management Suite (2026-2027)
# Backend Environment Configuration Template
# ===================================================

NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173

# MongoDB Connection String (e.g. mongodb://127.0.0.1:27017/akbar_cricket or MongoDB Atlas)
# If local MongoDB is not running, the application will automatically start an in-memory instance.
MONGODB_URI=mongodb://127.0.0.1:27017/akbar_cricket

# JWT Secret for Session Authentication (Minimum 32 characters)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# 32-Byte Hex Key for AES-256-GCM encryption of sensitive fields (NIC numbers)
# WARNING: Never alter this key once records are encrypted.
FIELD_ENCRYPTION_KEY=replace_with_a_secure_32_byte_hex_string_64_chars

# Default Initial Administrator Credentials (provisioned on first launch)
ADMIN_EMAIL=admin@akbarcricket.lk
ADMIN_PASSWORD=AkbarCricket@2026!

# Uploads directory (relative or absolute path)
UPLOADS_DIR=./uploads

# Optional AI Assistant configuration (leaves empty to use built-in rule-based engine)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
