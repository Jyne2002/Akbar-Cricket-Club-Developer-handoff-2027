{
  "name": "akbar-cricket-club",
  "version": "2.0.0",
  "private": true,
  "description": "Akbar Cricket Club frontend and API",
  "main": "backend/server.js",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "postinstall": "npm run install:all",
    "install:all": "npm ci --prefix backend --omit=dev && npm ci --prefix frontend --include=dev",
    "build": "npm run build --prefix frontend",
    "start": "node backend/server.js",
    "dev": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "test": "npm test --prefix backend",
    "audit:accounts": "node backend/scripts/auditAccounts.js",
    "db:check": "node backend/scripts/checkDatabase.js",
    "db:migrate": "node backend/scripts/migrateLocalStore.js"
  }
}
